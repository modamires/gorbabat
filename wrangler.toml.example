name = "gorbabat"
main = "worker.js"
compatibility_date = "2026-09-01"

[ai]
binding = "AI"

[[kv_namespaces]]
binding = "BOT_KV"
id = "PUT_YOUR_KV_NAMESPACE_ID_HERE"

[vars]
ADMIN_CHAT_ID = "PUT_ADMIN_CHAT_ID_HERE"
PUBLIC_BASE_URL = "https://PUT_YOUR_WORKER_HOST_HERE"
ECONOMY_CACHE_SECONDS = "120"
CF_WORKER_NAME = "gorbabat"

# Optional Cloudflare Analytics variables:
# CF_ACCOUNT_ID = "..."
# CF_API_TOKEN should preferably be stored as a secret.

# Add the Cron expressions you actually want:
# [triggers]
# crons = ["0 8 * * *", "0 20 * * *"]


# Required for mewMONEY! automatic history:
# Add "*/15 * * * *" alongside your existing Daily cron expression(s).
# Example only:
# [triggers]
# crons = ["*/15 * * * *", "<YOUR_EXISTING_DAILY_CRON>"]
